# Copy to pp/.env and generate two distinct random values of at least 32 characters.
PP_ROUTER_API_KEY=
OPENCODE_PASSWORD=

# Use the existing Principle-of-Procrastination/pp-router with its compatibility endpoint.
# PP_ROUTER_API_KEY must match that service's PPROUTER_API_KEY. Provider keys stay there.
PP_ROUTER_MODE=shared
PP_ROUTER_BASE_URL=http://127.0.0.1:4000/v1

# Optional standalone gateway from this fork (does not use PP's original routing policy):
# PP_ROUTER_MODE=standalone
# PP_ROUTER_CONFIG=pp/router.local.json
# PP_UPSTREAM_API_KEY=

# Optional: real PP application URLs. Omitted links are hidden.
VITE_PP_HOME_URL=
VITE_PP_CHAT_URL=
VITE_PP_FLOW_URL=
# Optional: PP help page. Help is hidden when unset.
VITE_PP_HELP_URL=
