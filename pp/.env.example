# Copy to pp/.env and generate two distinct random values of at least 32 characters.
PP_ROUTER_API_KEY=
OPENCODE_PASSWORD=

# Set the provider credential referenced by apiKeyEnv in pp/router.local.json.
PP_UPSTREAM_API_KEY=
PP_ROUTER_CONFIG=pp/router.local.json

# Optional: real PP application URLs. Omitted links are hidden.
VITE_PP_HOME_URL=
VITE_PP_CHAT_URL=
VITE_PP_FLOW_URL=
