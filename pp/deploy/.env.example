# A real hostname without a scheme or path. Blank values deliberately prevent startup.
PP_DOMAIN=

# Generate two different values with: openssl rand -hex 32
# OpenCode's sign-in username is "opencode".
OPENCODE_PASSWORD=
PP_ROUTER_API_KEY=

# The upstream provider key belongs only to the router container.
PP_UPSTREAM_API_KEY=

# Optional links to the rest of your PP suite; leave blank until those apps exist.
VITE_PP_HOME_URL=
VITE_PP_CHAT_URL=
VITE_PP_FLOW_URL=
