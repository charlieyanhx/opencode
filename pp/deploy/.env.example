# A real hostname without a scheme or path. Blank values deliberately prevent startup.
PP_DOMAIN=

# Generate the server password with: openssl rand -hex 32
# OpenCode's sign-in username is "opencode".
OPENCODE_PASSWORD=

# Your deployed Principle-of-Procrastination/pp-router HTTPS endpoint, ending in /v1.
# It must include the OpenAI-compatible /v1/chat/completions and /v1/models routes.
PP_ROUTER_BASE_URL=
# Must equal PPROUTER_API_KEY on that router; at least 32 characters, different from
# OPENCODE_PASSWORD. Vendor API keys belong only to the shared router service.
PP_ROUTER_API_KEY=

# Optional links to the rest of your PP suite; leave blank until those apps exist.
VITE_PP_HOME_URL=
VITE_PP_CHAT_URL=
VITE_PP_FLOW_URL=
VITE_PP_HELP_URL=
